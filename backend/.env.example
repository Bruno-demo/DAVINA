PORT=3000
NODE_ENV=production

# PostgreSQL
SQL_DB=skincare
SQL_USER=postgres
SQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SQL_HOST=postgres
SQL_PORT=5432

# MongoDB
MONGO_URI=mongodb://mongo:27017/skincare

# Redis
REDIS_URL=redis://redis:6379

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Face++ API (skin analysis)
FACE_API_KEY=
FACE_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:4200/checkout/callback

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@davina-beauty.com
ADMIN_EMAIL=admin@davina-beauty.com

# CORS — comma-separated origins
ALLOWED_ORIGINS=https://yourdomain.com
